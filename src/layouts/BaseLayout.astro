---
/**
 * HTML shell shared by every page: <head>, light/dark mode bootstrap, header, sidebar.
 * Used by PageLayout and the home page. The page background (`--page-art`) follows the theme,
 * see global.css and src/assets/images/backgrounds/.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import '../themes/themes.css';
import Header from '../components/layout/Header.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import CommandPalette from '../components/layout/CommandPalette.astro';
import LinkPreviews from '../components/layout/LinkPreviews.astro';
import SeoMeta from '../components/layout/SeoMeta.astro';
import { SITE, type Locale } from '../config/site';
import { useT } from '../i18n/ui';
import { getTree } from '../lib/tree';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Current slug, used for nav highlighting and the language switcher. */
  slug: string;
  theme?: string;
  /** Language of the main content when it differs (FR fallback on EN pages). */
  contentLang?: Locale;
  /** False to keep the page out of the search index (e.g. the search page itself). */
  indexable?: boolean;
  /** Full-width content column (frontmatter `layout: wide`). */
  wide?: boolean;
}

const { locale, title, description, slug, theme = 'base', contentLang, indexable = true, wide = false } = Astro.props;
const t = useT(locale);
const tree = await getTree(locale);
const pageTitle = slug ? `${title} · ${SITE.name}` : SITE.name;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <SeoMeta locale={locale} slug={slug} title={title} description={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/manifest.webmanifest`} />
    <meta name="theme-color" content="#23150d" />
    {import.meta.env.PROD && <script
      is:inline
      define:vars={{ sw: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js` }}
    >
      // Offline reading (see src/pages/sw.js.ts). Production only, so dev never serves stale pages.
      if ('serviceWorker' in navigator) navigator.serviceWorker.register(sw).catch(() => {});
    </script>}
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
    <script is:inline>
      // Apply the saved or system light/dark mode before paint (no flash).
      (() => {
        let mode;
        try {
          mode = localStorage.getItem('codex-mode');
        } catch {
          /* storage blocked: use system mode */
        }
        if (!mode) mode = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.mode = mode;
        document.documentElement.classList.add('js'); // enables JS-only UI such as the mobile drawer
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('nav.skip')}
    </a>
    <Header locale={locale} slug={slug} />
    <div class="shell" data-theme={theme}>
      <Sidebar tree={tree} locale={locale} current={slug} />
      <main
        id="main"
        class:list={['content', { 'content--wide': wide }]}
        lang={contentLang ?? locale}
        data-pagefind-body={indexable ? '' : undefined}
      >
        <slot />
      </main>
    </div>
    <CommandPalette locale={locale} />
    <LinkPreviews locale={locale} />
  </body>
</html>
