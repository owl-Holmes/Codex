---
/**
 * Layout of a content or section page: breadcrumbs, metadata, "read first",
 * body, children cards, sources, further reading, related pages and backlinks.
 */
import 'katex/dist/katex.min.css';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/navigation/TableOfContents.astro';
import PrevNext from '../components/navigation/PrevNext.astro';
import Breadcrumbs from '../components/navigation/Breadcrumbs.astro';
import PageList from '../components/knowledge/PageList.astro';
import ChildCards from '../components/knowledge/ChildCards.astro';
import Sources from '../components/knowledge/Sources.astro';
import PathBanner from '../components/knowledge/PathBanner.astro';
import KnowledgeGraph from '../components/knowledge/KnowledgeGraph.astro';
import PageHeader from '../components/knowledge/PageHeader.astro';
import { SITE, type Locale } from '../config/site';
import { useT } from '../i18n/ui';
import type { Page } from '../lib/pages';
import { findNode, getTrail, getTree, resolveTheme } from '../lib/tree';
import { getBacklinks, getRelated } from '../lib/knowledge';
import { pageStyles } from '../lib/page-styles';

interface Props {
  locale: Locale;
  slug: string;
  /** Undefined for a folder without index.mdx (auto-generated index). */
  page?: Page;
  fallback?: boolean;
  /** Headings of the rendered page, for the table of contents. */
  headings?: MarkdownHeading[];
}
const { locale, slug, page, fallback = false, headings = [] } = Astro.props;
const t = useT(locale);
const tree = await getTree(locale);
const node = findNode(tree, slug);
const trail = getTrail(tree, slug);
const data = page?.entry.data;
const title = data?.title ?? node?.title ?? slug;
const related = await getRelated(slug);
const backlinks = await getBacklinks(slug);
const notes = Object.fromEntries(
  related.map((r) => [r.slug, r.sharedTags.length ? `${t('page.sharedTag')} : ${r.sharedTags.join(', ')}` : '']),
);
const customCss = await pageStyles(data?.styles);
const editUrl = page?.entry.filePath ? `${SITE.repo}/edit/${SITE.branch}/${page.entry.filePath}` : undefined;
---

<BaseLayout
  locale={locale}
  slug={slug}
  title={title}
  description={data?.description ?? node?.description ?? ''}
  theme={resolveTheme(tree, slug, data?.theme)}
  contentLang={fallback ? 'fr' : locale}
  wide={data?.layout === 'wide'}
>
  {customCss && <style is:inline set:html={customCss} />}
  <Breadcrumbs trail={trail} locale={locale} />
  {fallback && (
    <p class="banner" role="note" lang={locale}>
      {t('page.fallback')}
    </p>
  )}
  <PathBanner locale={locale} slug={slug} />
  <article>
    {trail[0] && (
      <span hidden data-pagefind-filter={t('search.filterSection')}>
        {trail[0].title}
      </span>
    )}
    {data?.tags.map((tag) => (
      <span hidden data-pagefind-filter={t('search.filterTag')}>
        {tag}
      </span>
    ))}
    {data && (
      <span hidden data-pagefind-filter={t('search.filterStatus')}>
        {t(`status.${data.status}`)}
      </span>
    )}
    <PageHeader title={title} locale={locale} page={page} />
    {data && <PageList heading={t('page.readFirst')} slugs={data.prerequisites} locale={locale} />}
    <TableOfContents headings={headings} locale={locale} />
    <slot />
    {node && <ChildCards nodes={node.children} locale={locale} heading={t('page.children')} />}
    {data && <Sources sources={data.sources} heading={t('page.sources')} />}
    {data && <PageList heading={t('page.further')} slugs={data.furtherReading} locale={locale} />}
    <PageList heading={t('page.related')} slugs={related.map((r) => r.slug)} notes={notes} locale={locale} />
    <PageList heading={t('page.backlinks')} slugs={backlinks} locale={locale} />
    {data && <KnowledgeGraph locale={locale} focus={slug} />}
    <PrevNext tree={tree} slug={slug} locale={locale} />
  </article>
  {editUrl && (
    <p class="page-footer">
      <a href={editUrl}>{t('page.edit')}</a>
    </p>
  )}
</BaseLayout>

<style>
  .banner {
    background: var(--color-surface);
    border: 1px dashed var(--color-ornament);
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
  }
  .page-footer {
    margin-top: 3rem;
    font-size: 0.95rem;
  }
</style>
