---
/**
 * Home page hero: full-width "library wall" (repeating bookshelf illustration lit by a lamp glow),
 * title, intro, main actions (quick search, random page, shelves) and a few numbers.
 * Used only by src/pages/[lang]/index.astro (in BaseLayout's `hero` slot).
 */
import shelf from '../../assets/images/home/bookshelf.svg';
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import RandomPage from '../navigation/RandomPage.astro';

interface Props {
  locale: Locale;
  stats: { pages: number; sections: number; terms: number };
}
const { locale, stats } = Astro.props;
const t = useT(locale);
const numbers = [
  [stats.pages, t('home.pages')],
  [stats.sections, t('home.sections')],
  [stats.terms, t('home.terms')],
] as const;
---

<section class="hero" aria-labelledby="hero-title" style={`--shelf: url(${shelf.src})`}>
  <div class="hero-wall" aria-hidden="true"></div>
  <div class="hero-inner">
    <p class="eyebrow">{t('home.eyebrow')}</p>
    <h1 id="hero-title" class="hero-title">
      {t('home.title')}
    </h1>
    <p class="hero-intro">{t('home.intro')}</p>
    <div class="hero-actions">
      <button type="button" class="btn btn--primary" data-open-palette>
        {t('home.searchCta')}
        <kbd>Ctrl K</kbd>
      </button>
      <RandomPage locale={locale} class="btn" />
      <a class="btn" href="#shelves">
        {t('home.explore')} ↓
      </a>
    </div>
    <dl class="hero-stats" aria-label={t('home.stats')}>
      {numbers.map(([value, label]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-on-wood);
    background: var(--color-wood);
  }
  .hero-wall {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse 50% 60% at 50% 45%,
        color-mix(in srgb, var(--color-wood) 82%, transparent),
        color-mix(in srgb, var(--color-wood) 35%, transparent) 75%
      ),
      linear-gradient(180deg, transparent 60%, var(--color-wood)),
      var(--shelf) 0 0 / 520px 180px repeat;
    animation: drift 90s linear infinite;
  }
  .hero-wall::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 30%, var(--color-lamp), transparent 45%);
    opacity: 0.22;
    mix-blend-mode: soft-light;
    animation: flicker 6s ease-in-out infinite;
  }
  .hero-inner {
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(4rem, 10vw, 7.5rem) 1.5rem clamp(3rem, 7vw, 5rem);
    text-align: center;
    animation: fade-up 900ms var(--ease) both;
  }
  .eyebrow {
    margin-bottom: 0.8rem;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-brass);
  }
  .hero-title {
    font-family: var(--font-brand);
    font-size: clamp(3rem, 2rem + 6vw, 6rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-on-wood);
    text-shadow: 0 2px 30px var(--color-wood);
  }
  .hero-intro {
    max-width: 36rem;
    margin: 1rem auto 2rem;
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-on-wood-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .hero-actions .btn,
  .hero-actions :global(.btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.9rem;
    padding: 0.55rem 1.3rem;
    border: 1px solid color-mix(in srgb, var(--color-on-wood) 35%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-wood) 55%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-on-wood);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition:
      translate var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }
  .hero-actions .btn:hover,
  .hero-actions :global(.btn:hover) {
    translate: 0 -2px;
    border-color: var(--color-brass);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--color-lamp) 30%, transparent);
  }
  .hero-actions .btn--primary {
    border-color: var(--color-brass);
    background: var(--color-brass);
    color: var(--color-wood);
    font-weight: 600;
  }
  .btn--primary kbd {
    padding: 0.05rem 0.45rem;
    border: 1px solid color-mix(in srgb, var(--color-wood) 35%, transparent);
    border-radius: 6px;
    font-family: inherit;
    font-size: var(--text-xs);
  }
  .hero :focus-visible {
    outline-color: var(--color-lamp);
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    margin: 3rem 0 0;
  }
  .hero-stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .hero-stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--color-brass);
  }
  .hero-stats dt {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-on-wood-muted);
  }
  @keyframes drift {
    to {
      background-position:
        0 0,
        0 0,
        -520px 0;
    }
  }
  @keyframes flicker {
    0%,
    100% {
      opacity: 0.22;
    }
    45% {
      opacity: 0.3;
    }
    55% {
      opacity: 0.18;
    }
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }
</style>
