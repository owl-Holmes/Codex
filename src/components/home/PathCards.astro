---
/** Home page list of thematic paths (rich PathCard each) and a link to all paths. */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import type { getPaths } from '../../lib/paths';
import { pageUrl } from '../../lib/urls';
import PathCard from '../knowledge/PathCard.astro';

interface Props {
  locale: Locale;
  paths: Awaited<ReturnType<typeof getPaths>>;
}
const { locale, paths } = Astro.props;
const t = useT(locale);
---

<ul class="card-list" role="list">
  {paths.map((p) => (
    <li>
      <PathCard path={p} locale={locale} />
    </li>
  ))}
</ul>
<a class="more" href={pageUrl(locale, 'paths')}>
  {t('home.allPaths')} →
</a>

<style>
  .more {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
</style>
