---
/**
 * One glossary term as a full-width sheet: term (permalink with its `#id` anchor) and variants on
 * the left, definition and optional Markdown notes on the right; stacked on narrow screens.
 * The term is an h2 with the term id, so Pagefind returns it as its own search sub-result and
 * Term / the A–Z index can link straight to it. Used by pages/[lang]/glossary.astro.
 */
import { render } from 'astro:content';
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import type { GlossaryTerm } from '../../lib/glossary';

interface Props {
  term: GlossaryTerm;
  locale: Locale;
}
const { term, locale } = Astro.props;
const t = useT(locale);
const { id, entry, fallback } = term;
const { Content: Notes } = await render(entry);
---

<article class="glossary-sheet" lang={fallback ? 'fr' : locale}>
  <header>
    <h2 id={id} class="term">
      <a href={`#${id}`} title={t('glossary.permalink')}>
        {entry.data.term}
        <span class="hash" aria-hidden="true">
          #
        </span>
      </a>
    </h2>
    {entry.data.aliases.length > 0 && (
      <p class="aliases">
        <span class="ui-label">{t('glossary.aliases')}</span>
        {entry.data.aliases.map((alias) => (
          <span class="badge">{alias}</span>
        ))}
      </p>
    )}
  </header>
  <div class="sheet-body">
    <p class="definition">{entry.data.definition}</p>
    <div class="notes">
      <Notes />
    </div>
  </div>
</article>

<style>
  .glossary-sheet {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }
  .glossary-sheet:hover {
    border-color: var(--color-ornament);
    border-left-color: var(--color-accent);
  }
  .glossary-sheet:has(:target) {
    box-shadow: var(--glow);
  }
  .term {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--text-lg);
    line-height: 1.25;
  }
  .term a {
    color: inherit;
    text-decoration: none;
  }
  /* Permalink hint, visible on hover / keyboard focus only. */
  .hash {
    margin-left: 0.3rem;
    color: var(--color-accent);
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }
  .term a:hover .hash,
  .term a:focus-visible .hash {
    opacity: 1;
  }
  .aliases {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    margin: 0.5rem 0 0;
  }
  .sheet-body {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }
  .definition {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 500;
    line-height: 1.55;
  }
  .notes {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .notes :global(p) {
    margin: 0.5rem 0 0;
  }
  @media (max-width: 700px) {
    .glossary-sheet {
      grid-template-columns: minmax(0, 1fr);
    }
    .sheet-body {
      padding: 0.6rem 0 0;
      border-top: 1px solid var(--color-border);
      border-left: 0;
    }
  }
</style>
