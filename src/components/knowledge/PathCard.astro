---
/**
 * Card of a thematic path (paths list, home page): sections crossed, title, description,
 * the numbered route of its steps, reading progress and a "Start" call to action.
 * The whole card is one link to the path page.
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { resolveSteps, type ThematicPath } from '../../lib/paths';
import { pageUrl } from '../../lib/urls';
import StepProgress from './StepProgress.astro';

interface Props {
  path: ThematicPath;
  locale: Locale;
}
const { path, locale } = Astro.props;
const t = useT(locale);
const steps = await resolveSteps(locale, path);
const sections = [...new Set(steps.map((s) => s.section).filter(Boolean))];
---

<a class="path-card" data-no-preview href={pageUrl(locale, `paths/${path.id}`)}>
  <span class="head">
    <span class="count">
      <strong>{steps.length}</strong>
      <span>{t('paths.steps')}</span>
    </span>
    <span class="sections">
      {sections.map((s) => (
        <span class="badge">{s}</span>
      ))}
    </span>
  </span>
  <span class="title">{path.data.title}</span>
  <span class="desc">{path.data.description}</span>
  <ol class="route">
    {steps.map((s, i) => (
      <li>
        <span class="num">{i + 1}</span>
        <span class="step-title">{s.title}</span>
      </li>
    ))}
  </ol>
  <span class="foot">
    <StepProgress pages={steps.map((s) => s.page)} locale={locale} />
    <span class="cta">{t('paths.start')} →</span>
  </span>
</a>

<style>
  .path-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    height: 100%;
    padding: 1.3rem 1.4rem 1.1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 100% 0, color-mix(in srgb, var(--color-accent) 9%, transparent), transparent 45%),
      var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      translate var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }
  /* Accent band on top. */
  .path-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-ornament));
  }
  .path-card:hover {
    translate: 0 -3px;
    border-color: var(--color-ornament);
    box-shadow: var(--shadow-lg);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-label);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .count strong {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1;
    letter-spacing: 0;
    color: var(--color-accent);
  }
  .sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.2;
  }
  .desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  /* Numbered route: small circles joined by a vertical line. */
  .route {
    position: relative;
    display: grid;
    gap: 0.45rem;
    margin: 0.2rem 0 0;
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    list-style: none;
  }
  .route::before {
    content: '';
    position: absolute;
    left: calc(0.9rem + 0.7rem - 1px);
    top: 1.4rem;
    bottom: 1.4rem;
    width: 2px;
    background: color-mix(in srgb, var(--color-accent) 30%, transparent);
  }
  .route li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-sm);
  }
  .num {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1.5px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-accent);
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
  }
  /* min-width: 0 lets the flex item shrink so long titles end with an ellipsis. */
  .step-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border);
  }
  .foot :global(.step-progress) {
    flex: 1;
  }
  .cta {
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: translate var(--duration) var(--ease);
  }
  .path-card:hover .cta {
    translate: 3px 0;
  }
</style>
