---
/**
 * One letter of the A–Z index: a panel with the letter bubble, the entry count and one fully
 * clickable row per entry (title, one-line description, kind badge). The panel carries the
 * `#letter-<L>` anchor targeted by LetterNav. Used by pages/[lang]/a-z.astro.
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';

/** One row of the index: a page or a glossary term. */
export interface IndexEntry {
  label: string;
  url: string;
  /** Badge text: the page's top-level section, or "Glossary". */
  kind: string;
  /** One-line description (page description or term definition). */
  text: string;
  /** Glossary terms get an accent badge. */
  isTerm: boolean;
}

interface Props {
  letter: string;
  entries: IndexEntry[];
  locale: Locale;
}
const { letter, entries, locale } = Astro.props;
const t = useT(locale);
const headingId = `h-${letter}`;
---

<section id={`letter-${letter}`} class="letter-panel" aria-labelledby={headingId}>
  <header class="panel-head">
    <h2 id={headingId} class="letter">
      {letter}
    </h2>
    <span class="ui-label">
      {entries.length} {t(entries.length > 1 ? 'az.entries' : 'az.entry')}
    </span>
  </header>
  <ul class="rows">
    {entries.map((item) => (
      <li>
        <a class="row" href={item.url} data-no-preview>
          <span class="row-main">
            <span class="row-title">{item.label}</span>
            <span class="row-text">{item.text}</span>
          </span>
          <span class:list={['badge', { 'badge--accent': item.isTerm }]}>{item.kind}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .letter-panel {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    scroll-margin-top: calc(var(--header-height) + 5rem);
  }
  .letter-panel:target {
    box-shadow: var(--glow);
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface));
  }
  .letter {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-label);
    font-size: var(--text-md);
  }
  .rows {
    margin: 0;
    padding: 0.3rem;
    list-style: none;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--duration) var(--ease);
  }
  .row:hover,
  .row:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }
  .row-main {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .row-title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
  }
  .row:hover .row-title {
    color: var(--color-accent);
  }
  /* min-width: 0 lets the grid item shrink so the ellipsis can apply. */
  .row-text {
    min-width: 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .badge {
    flex: none;
  }
</style>
