---
/**
 * Reading progress of a thematic path: a segmented bar (one segment per step) and "n / total".
 * Segments of pages already read in this browser fill in (client script, localStorage via visited.ts).
 * Used by PathCard and each path page.
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';

interface Props {
  /** Page slugs of the steps, in order. */
  pages: string[];
  locale: Locale;
}
const { pages, locale } = Astro.props;
const t = useT(locale);
---

<div class="step-progress">
  <ol class="segments" aria-hidden="true">
    {pages.map((page) => (
      <li data-page={page} />
    ))}
  </ol>
  <span class="ui-label count">
    <span class="visually-hidden">{t('paths.progress')} :</span>
    <span class="done">0</span>/{pages.length} {t('paths.read')}
  </span>
</div>

<script>
  import { getVisited } from './visited';
  const visited = getVisited();
  document.querySelectorAll<HTMLElement>('.step-progress').forEach((box) => {
    const segments = [...box.querySelectorAll<HTMLElement>('li[data-page]')];
    segments.forEach((s) => s.classList.toggle('is-done', visited.has(s.dataset.page ?? '')));
    const done = box.querySelector('.done');
    if (done) done.textContent = String(segments.filter((s) => s.classList.contains('is-done')).length);
  });
</script>

<style>
  .step-progress {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .segments {
    display: flex;
    flex: 1;
    gap: 4px;
    min-width: 6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-accent) 18%, transparent);
    transition: background var(--duration) var(--ease);
  }
  li:global(.is-done) {
    background: var(--color-accent);
  }
  .count {
    white-space: nowrap;
  }
</style>
