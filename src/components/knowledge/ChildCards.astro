---
/** Cards for the children of a folder: used by section pages (auto-generated or with index.mdx). */
import type { Locale } from '../../config/site';
import type { TreeNode } from '../../lib/tree';
import SectionCard from './SectionCard.astro';

interface Props {
  nodes: TreeNode[];
  locale: Locale;
  heading: string;
}
const { nodes, locale, heading } = Astro.props;
---

{nodes.length > 0 && (
  <section>
    <h2>{heading}</h2>
    <div class="card-grid">
      {nodes.map((n, i) => (
        <SectionCard node={n} locale={locale} index={i} />
      ))}
    </div>
  </section>
)}
