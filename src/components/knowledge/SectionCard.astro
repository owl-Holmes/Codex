---
/**
 * Compact "book" card for a section or page: name, page count, a colour (section.yml `color`,
 * otherwise a leather tone picked from its position, so neighbours differ) and the section icon
 * as a tilted watermark.
 * The whole card is clickable (stretched title link). Used by the home page and ChildCards.
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { countPages, type TreeNode } from '../../lib/tree';
import { pageUrl } from '../../lib/urls';
import SectionIcon from './SectionIcon.astro';

interface Props {
  node: TreeNode;
  locale: Locale;
  /** Position in the list: default colour and staggered entrance animation. */
  index?: number;
  /** Heading level of the title, to keep the outline correct where the card is used. */
  level?: 2 | 3;
}
const { node, locale, index = 0, level = 3 } = Astro.props;
const t = useT(locale);
const Heading = `h${level}` as const;
const isFolder = node.children.length > 0;
const pages = countPages(node);
const color = node.color ?? `var(--leather-${(index % 8) + 1})`;
---

<article class="book-card" style={`--card: ${color}; --i: ${index}`}>
  <span class="watermark" aria-hidden="true">
    <SectionIcon name={node.icon ?? (isFolder ? 'book' : 'quill')} size="5.5rem" />
  </span>
  <Heading class="book-title">
    <a href={pageUrl(locale, node.slug)}>{node.title}</a>
  </Heading>
  {isFolder && (
    <p class="book-meta">
      {pages} {t(pages === 1 ? 'home.page' : 'home.pages')}
    </p>
  )}
</article>

<style>
  .book-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.4rem;
    min-height: 6.5rem;
    padding: 0.9rem 1rem 0.8rem 1.2rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-left: 5px solid var(--card);
    border-radius: var(--radius);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--card) 22%, var(--color-surface)),
      var(--color-surface) 75%
    );
    box-shadow: var(--shadow-sm);
    animation: rise 500ms var(--ease) backwards;
    animation-delay: calc(var(--i) * 50ms);
    transition:
      translate var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }
  .book-card:hover,
  .book-card:focus-within {
    translate: 0 -4px;
    border-color: var(--card);
    box-shadow:
      var(--shadow-lg),
      0 0 0 1px var(--card);
  }
  .watermark {
    position: absolute;
    right: -0.9rem;
    bottom: -1.1rem;
    color: var(--card);
    opacity: 0.3;
    rotate: -14deg;
    pointer-events: none;
    transition:
      rotate 450ms var(--ease),
      scale 450ms var(--ease),
      opacity var(--duration) var(--ease);
  }
  .book-card:hover .watermark {
    rotate: -4deg;
    scale: 1.12;
    opacity: 0.5;
  }
  .book-title {
    margin: 0;
    padding-right: 2.5rem;
    font-size: var(--text-md);
    line-height: 1.25;
  }
  .book-title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .book-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .book-card:has(.book-title a:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .book-title a:focus-visible {
    outline: none;
  }
  .book-meta {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }
</style>
