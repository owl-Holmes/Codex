---
/**
 * Interactive knowledge graph (SVG, no library) with a full text alternative.
 * Data is computed at build time and embedded as JSON; layout runs in the browser.
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getGraph } from '../../lib/graph';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const data = await getGraph(locale);
const titleOf = new Map(data.nodes.map((n) => [n.id, n]));
---

<figure class="graph">
  <svg class="graph-canvas" viewBox="0 0 900 560" role="group" aria-label={t('graph.label')}>
    <text x="450" y="280" text-anchor="middle">{t('graph.loading')}</text>
  </svg>
  <figcaption class="legend">
    <span><i class="key key--prerequisite"></i>{t('graph.prerequisite')}</span>
    <span><i class="key key--related"></i>{t('graph.related')}</span>
    <span><i class="key key--tag"></i>{t('graph.tag')}</span>
  </figcaption>
  <script type="application/json" class="graph-data" set:html={JSON.stringify(data)} />
</figure>

<details class="graph-list">
  <summary>{t('graph.textList')}</summary>
  <ul>
    {
      data.nodes.map((n) => (
        <li>
          <a href={n.url}>{n.title}</a> <small>({n.section})</small>
          <ul>
            {data.edges
              .filter((e) => e.source === n.id || e.target === n.id)
              .map((e) => {
                const other = titleOf.get(e.source === n.id ? e.target : e.source);
                return other && <li>{t(`graph.${e.kind === 'further' ? 'related' : e.kind}`)} : {other.title}</li>;
              })}
          </ul>
        </li>
      ))
    }
  </ul>
</details>

<script>
  import { renderGraph } from './graph-sim';
  const svg = document.querySelector<SVGSVGElement>('.graph-canvas');
  const raw = document.querySelector('.graph-data')?.textContent;
  if (svg && raw) renderGraph(svg, JSON.parse(raw));
</script>

<style>
  .graph-canvas {
    width: 100%;
    height: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .graph-canvas :global(text) { fill: var(--color-text); font-size: 13px; font-family: var(--font-body); }
  .graph-canvas :global(.edge) { stroke: var(--color-border); stroke-width: 1; }
  .graph-canvas :global(.edge--prerequisite) { stroke: var(--callout-warning); stroke-width: 2; }
  .graph-canvas :global(.edge--related), .graph-canvas :global(.edge--further) { stroke: var(--color-ornament); stroke-width: 1.5; }
  .graph-canvas :global(.edge--tag) { stroke-dasharray: 4 4; }
  .graph-canvas :global(.node circle) { fill: var(--color-accent); stroke: var(--color-bg); stroke-width: 2; }
  .graph-canvas :global(.node:hover circle), .graph-canvas :global(.node:focus circle) { r: 12; }
  .graph-canvas :global(.node:focus) { outline: none; }
  .graph-canvas :global(.node:focus text) { font-weight: 700; text-decoration: underline; }
  .legend { display: flex; gap: 1.2rem; font-size: 0.9rem; color: var(--color-muted); margin-top: 0.5rem; }
  .key { display: inline-block; width: 1.6rem; height: 0; border-top: 2px solid var(--color-border); margin-right: 0.4rem; vertical-align: middle; }
  .key--prerequisite { border-color: var(--callout-warning); }
  .key--related { border-color: var(--color-ornament); }
  .key--tag { border-top-style: dashed; }
  .graph-list { margin-top: 1rem; }
</style>
