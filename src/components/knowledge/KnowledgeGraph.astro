---
/**
 * Knowledge graph: SVG drawn at build time (GraphCanvas) plus a full text alternative (GraphTextList).
 * With `focus`, shows only that page and its direct neighbors (local graph, no text list:
 * the page's related/backlinks lists already provide it).
 * Used by the home page, the graph page and PageLayout.
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getGraph, neighborhood } from '../../lib/graph';
import GraphCanvas from './GraphCanvas.astro';
import GraphTextList from './GraphTextList.astro';

interface Props {
  locale: Locale;
  /** Slug of the current page for a local graph. */
  focus?: string;
}
const { locale, focus } = Astro.props;
const t = useT(locale);
const full = await getGraph(locale);
const data = focus ? neighborhood(full, focus) : full;
const [width, height] = focus ? [700, 320] : [900, 560];
/** A local graph with no neighbor is pointless: render nothing. */
const empty = Boolean(focus) && data.nodes.length < 2;
---

{!empty && (
  <figure class="graph">
    {focus && <h2 class="graph-heading">{t('graph.local')}</h2>}
    <GraphCanvas data={data} locale={locale} width={width} height={height} focus={focus} />
  </figure>
)}
{!focus && <GraphTextList data={data} locale={locale} />}

<style>
  .graph-heading {
    font-size: var(--text-lg);
  }
</style>
