---
/**
 * Image grid with an accessible lightbox (native <dialog>, Esc or click outside to close).
 * Without JavaScript, each thumbnail links to the full image.
 * Usage: <Gallery images={[{ src: 'sciences/a.svg', alt: '…', caption: '…' }]} />
 * `src` is relative to src/assets/images/; `alt` is required. Override: .gallery, --gallery-min
 */
import { Image, getImage } from 'astro:assets';
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { resolveImage } from '../../lib/images';

interface Item {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  images: Item[];
}
const t = useT((Astro.currentLocale ?? 'fr') as Locale);
const items = await Promise.all(
  Astro.props.images.map(async (item) => {
    if (!item.alt) throw new Error(`Gallery "${item.src}": "alt" is required.`);
    const image = await resolveImage(item.src, 'Gallery');
    return { ...item, image, full: (await getImage({ src: image, width: Math.min(image.width, 1600) })).src };
  }),
);
---

<div class="gallery">
  <ul role="list">
    {items.map((item) => (
      <li>
        <a href={item.full} data-caption={item.caption ?? ''} data-alt={item.alt}>
          <Image src={item.image} alt={item.alt} width={320} />
        </a>
        {item.caption && <p>{item.caption}</p>}
      </li>
    ))}
  </ul>
  <dialog class="lightbox" aria-label={t('gallery.viewer')}>
    <button type="button" class="lightbox-close" aria-label={t('gallery.close')}>
      ✕
    </button>
    <img alt="" />
    <p class="lightbox-caption"></p>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('.lightbox')!;
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('.lightbox-caption')!;
    gallery.querySelectorAll<HTMLAnchorElement>('li > a').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        img.src = link.href;
        img.alt = link.dataset.alt ?? '';
        caption.textContent = link.dataset.caption ?? '';
        dialog.showModal();
      });
    });
    dialog.querySelector('.lightbox-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  });
</script>

<style>
  .gallery ul {
    --gallery-min: 10rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--gallery-min), 1fr));
    gap: 0.8rem;
    padding: 0;
    margin-block: 1.25rem;
  }
  .gallery li a {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.4rem;
  }
  .gallery li :global(img) {
    width: 100%;
    height: 9rem;
    object-fit: contain;
  }
  .gallery li p {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--color-muted);
    text-align: center;
  }
  .lightbox {
    max-width: min(90vw, 1100px);
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .lightbox::backdrop {
    background: var(--backdrop);
  }
  .lightbox img {
    max-height: 78vh;
    margin-inline: auto;
  }
  .lightbox-close {
    float: right;
    min-width: 2.25rem;
    min-height: 2.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .lightbox-caption {
    text-align: center;
    margin: 0.5rem 0 0;
    color: var(--color-muted);
  }
</style>
