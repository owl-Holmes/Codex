---
/**
 * Vertical timeline of dated events.
 * Usage: <Timeline items={[{ date: '1910', title: 'Laboratoire de Lyon', text: '…' }]} />
 * Override: .timeline, .timeline-date, --timeline-color
 */
interface Item {
  date: string;
  title: string;
  text?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item) => (
      <li>
        <p class="timeline-date">{item.date}</p>
        <p class="timeline-title">{item.title}</p>
        {item.text && <p class="timeline-text">{item.text}</p>}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    --timeline-color: var(--color-ornament);
    list-style: none;
    padding-left: 1.5rem;
    margin-block: 1.5rem;
    border-left: 2px solid var(--timeline-color);
  }
  li { position: relative; margin-bottom: 1.2rem; }
  li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--timeline-color);
  }
  p { margin: 0; }
  .timeline-date { font-family: var(--font-display); font-weight: 700; color: var(--color-accent); }
  .timeline-title { font-weight: 600; }
  .timeline-text { color: var(--color-muted); font-size: 0.98rem; }
</style>
