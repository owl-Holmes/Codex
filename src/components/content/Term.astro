---
/**
 * Glossary term: links to its glossary entry and shows the definition as a tooltip
 * on hover and keyboard focus (CSS only).
 * Usage: <Term id="chromatographie">chromatographie</Term> — id = glossary file name.
 */
import { getEntry } from 'astro:content';
import type { Locale } from '../../config/site';
import { pageUrl } from '../../lib/urls';

interface Props {
  id: string;
}
const { id } = Astro.props;
const locale = (Astro.currentLocale ?? 'fr') as Locale;
const entry = (await getEntry('glossary', `${locale}/${id}`)) ?? (await getEntry('glossary', `fr/${id}`));
if (!entry) throw new Error(`Term: unknown glossary entry "${id}"`);
const tipId = `term-${id}-${Math.random().toString(36).slice(2, 7)}`;
---

<span class="term">
  <a href={`${pageUrl(locale, 'glossary')}#${id}`} aria-describedby={tipId}>
    <slot />
  </a>
  <span role="tooltip" id={tipId} class="term-tip">
    <strong>{entry.data.term}</strong> — {entry.data.definition}
  </span>
</span>

<style>
  .term {
    position: relative;
  }
  .term > a {
    color: inherit;
    text-decoration: underline dotted var(--color-accent);
    cursor: help;
  }
  .term-tip {
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 5;
    width: max-content;
    max-width: min(22rem, calc(100vw - 2rem));
    padding: 0.6rem 0.8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.95rem;
    box-shadow: var(--shadow-lg);
    display: none; /* not just hidden: a hidden box still widens the page on phones */
  }
  .term:hover .term-tip,
  .term:focus-within .term-tip {
    display: block;
  }
  /* Phones: show the definition as a card pinned to the bottom of the screen, never off-screen. */
  @media (max-width: 600px) {
    .term-tip {
      position: fixed;
      inset: auto 1rem 1rem;
      width: auto;
      max-width: none;
    }
  }
</style>
