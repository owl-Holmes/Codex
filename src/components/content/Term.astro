---
/**
 * Glossary term with an accessible definition tooltip (CSS only, works on hover and focus).
 * Usage: <Term id="chromatographie">chromatographie</Term> — id = glossary file name.
 */
import { getEntry } from 'astro:content';
import type { Locale } from '../../config/site';

interface Props {
  id: string;
}
const { id } = Astro.props;
const locale = (Astro.currentLocale ?? 'fr') as Locale;
const entry = (await getEntry('glossary', `${locale}/${id}`)) ?? (await getEntry('glossary', `fr/${id}`));
if (!entry) throw new Error(`Term: unknown glossary entry "${id}"`);
const tipId = `term-${id}-${Math.random().toString(36).slice(2, 7)}`;
---

<span class="term" tabindex="0" aria-describedby={tipId}>
  <slot />
  <span role="tooltip" id={tipId} class="term-tip">
    <strong>{entry.data.term}</strong> — {entry.data.definition}
  </span>
</span>

<style>
  .term {
    position: relative;
    border-bottom: 1px dotted var(--color-accent);
    cursor: help;
  }
  .term-tip {
    position: absolute;
    left: 0;
    top: 100%;
    z-index: 5;
    width: max-content;
    max-width: 22rem;
    padding: 0.6rem 0.8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-size: 0.95rem;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.15);
    visibility: hidden;
  }
  .term:hover .term-tip,
  .term:focus .term-tip { visibility: visible; }
</style>
