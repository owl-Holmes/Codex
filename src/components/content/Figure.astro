---
/**
 * Optimized image from the central media folder, with caption and credit.
 * Usage: <Figure src="sciences/alambic.svg" alt="Description" caption="…" credit="…" />
 * `src` is relative to src/assets/images/. `alt` is required ("" only with `decorative`).
 */
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  decorative?: boolean;
}
const { src, alt, caption, credit, decorative = false } = Astro.props;
if (!alt && !decorative) throw new Error(`Figure "${src}": "alt" is required (or set decorative).`);
const image = await resolveImage(src, 'Figure');
---

<figure class="figure">
  <Image src={image} alt={decorative ? '' : alt} />
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {credit && <span class="credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure { margin-block: 1.5rem; }
  .figure :global(img) { margin-inline: auto; border-radius: var(--radius); }
  figcaption { font-size: 0.95rem; color: var(--color-muted); text-align: center; margin-top: 0.5rem; }
  .credit { display: block; font-size: 0.85rem; font-style: italic; }
</style>
