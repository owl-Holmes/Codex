---
/**
 * Highlighted quotation with attribution.
 * Usage: <PullQuote author="Edmond Locard" source="Traité de criminalistique">Tout contact laisse une trace.</PullQuote>
 * Override: .pull-quote
 */
interface Props {
  author?: string;
  source?: string;
}
const { author, source } = Astro.props;
---

<figure class="pull-quote">
  <blockquote>
    <slot />
  </blockquote>
  {(author || source) && (
    <figcaption>
      — {author}
      {source && <cite>{author ? `, ${source}` : source}</cite>}
    </figcaption>
  )}
</figure>

<style>
  .pull-quote {
    margin: 2rem 0;
    padding: 0.5rem 0 0.5rem 1.5rem;
    border-left: 4px solid var(--color-ornament);
  }
  blockquote {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.35;
  }
  blockquote :global(p) {
    margin: 0;
  }
  figcaption {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
</style>
