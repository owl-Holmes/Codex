---
/**
 * Video: YouTube / Vimeo behind a privacy-friendly facade (nothing loads until click),
 * or a local file from src/assets/video/ with optional WebVTT captions.
 * Usage: <Video youtube="VIDEO_ID" title="…" />
 *        <Video src="sciences/demo.mp4" captions="sciences/demo.fr.vtt" title="…" />
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';

interface Props {
  title: string;
  youtube?: string;
  vimeo?: string;
  /** Path relative to src/assets/video/. */
  src?: string;
  /** WebVTT file relative to src/assets/video/. */
  captions?: string;
}
const { title, youtube, vimeo, src, captions } = Astro.props;
const locale = (Astro.currentLocale ?? 'fr') as Locale;
const t = useT(locale);

const files = import.meta.glob<string>('/src/assets/video/**/*', { query: '?url', import: 'default' });
const resolve = async (path?: string) => {
  if (!path) return undefined;
  const load = files[`/src/assets/video/${path}`];
  if (!load) throw new Error(`Video: file not found in src/assets/video/: "${path}"`);
  return load();
};
const fileUrl = await resolve(src);
const captionsUrl = await resolve(captions);
const embed = youtube
  ? `https://www.youtube-nocookie.com/embed/${youtube}?autoplay=1`
  : vimeo
    ? `https://player.vimeo.com/video/${vimeo}?autoplay=1&dnt=1`
    : undefined;
if (!embed && !fileUrl) throw new Error(`Video "${title}": provide youtube, vimeo or src.`);
---

<figure class="video">
  {
    fileUrl ? (
      <video controls preload="metadata" title={title}>
        <source src={fileUrl} />
        {captionsUrl && <track kind="captions" src={captionsUrl} srclang={locale} label={locale.toUpperCase()} default />}
      </video>
    ) : (
      <button type="button" class="video-facade" data-embed={embed} data-title={title}>
        <span class="play" aria-hidden="true">▶</span>
        <span>{t('video.play')} : {title}</span>
        <small>{t('video.external')}</small>
      </button>
    )
  }
  <figcaption>{title}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.video-facade').forEach((button) => {
    button.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = button.dataset.embed ?? '';
      iframe.title = button.dataset.title ?? '';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      button.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video { margin-block: 1.5rem; }
  .video video, .video :global(iframe), .video-facade {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #111;
  }
  .video-facade {
    display: grid;
    place-content: center;
    gap: 0.4rem;
    color: #f5efe0;
    font: inherit;
    cursor: pointer;
  }
  .play { font-size: 3rem; color: var(--color-ornament); }
  figcaption { font-size: 0.95rem; color: var(--color-muted); text-align: center; margin-top: 0.5rem; }
</style>
