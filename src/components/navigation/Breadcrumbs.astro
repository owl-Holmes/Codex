---
/** Breadcrumb trail from the language home down to the current page, plus BreadcrumbList structured data. */
import { SITE, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import type { TreeNode } from '../../lib/tree';
import { pageUrl } from '../../lib/urls';

interface Props {
  trail: TreeNode[];
  locale: Locale;
}
const { trail, locale } = Astro.props;
const t = useT(locale);
const crumbs = [{ title: t('home.title'), slug: '' }, ...trail];
const structured = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title,
    item: new URL(pageUrl(locale, c.slug), SITE.url).href,
  })),
};
---

<nav aria-label={t('nav.breadcrumb')} class="breadcrumbs">
  <ol>
    <li>
      <a href={pageUrl(locale, '')}>{t('home.title')}</a>
    </li>
    {trail.map((node, i) => (
      <li>
        {i === trail.length - 1 ? (
          <span aria-current="page">{node.title}</span>
        ) : (
          <a href={pageUrl(locale, node.slug)}>{node.title}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(structured)} />
<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }
  li + li::before {
    content: '›';
    margin-inline: 0.5rem;
    color: var(--color-ornament);
  }
  [aria-current] {
    color: var(--color-muted);
  }
</style>
