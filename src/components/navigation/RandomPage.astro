---
/**
 * "Random page" link: picks a page from the locale's previews.json index (built at compile time).
 * Without JavaScript it simply leads to the A–Z index.
 */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { pageUrl, withBase } from '../../lib/urls';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const index = withBase(`${locale}/previews.json`).replace(/\/$/, '');
---

<a class="pill random-page" href={pageUrl(locale, 'a-z')} data-index={index}>
  ⚄ {t('nav.random')}
</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.random-page').forEach((link) => {
    link.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        const urls = Object.keys(await (await fetch(link.dataset.index ?? '')).json());
        const others = urls.filter((u) => u !== location.pathname);
        location.assign(others[Math.floor(Math.random() * others.length)] ?? link.href);
      } catch {
        location.assign(link.href);
      }
    });
  });
</script>
