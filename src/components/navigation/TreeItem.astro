---
/** One node of the sidebar tree; renders itself recursively. The current branch is open. */
import type { Locale } from '../../config/site';
import type { TreeNode } from '../../lib/tree';
import { pageUrl } from '../../lib/urls';

interface Props {
  node: TreeNode;
  locale: Locale;
  current: string;
}
const { node, locale, current } = Astro.props;
const isCurrent = node.slug === current;
const isOpen = isCurrent || current.startsWith(`${node.slug}/`);
const href = pageUrl(locale, node.slug);
const ariaCurrent = isCurrent ? 'page' : undefined;
---

<li>
  {node.children.length ? (
    <details open={isOpen}>
      <summary>
        <a href={href} aria-current={ariaCurrent}>
          {node.title}
        </a>
      </summary>
      <ul role="list">
        {node.children.map((child) => (
          <Astro.self node={child} locale={locale} current={current} />
        ))}
      </ul>
    </details>
  ) : (
    <a href={href} aria-current={ariaCurrent}>
      {node.title}
    </a>
  )}
</li>

<style>
  li {
    margin: 0.15rem 0;
  }
  ul {
    list-style: none;
    padding-left: 1rem;
    margin: 0;
    border-left: 1px solid var(--color-border);
  }
  a {
    display: inline-block;
    min-height: 24px; /* WCAG 2.5.8 target size */
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    transition:
      color var(--duration) var(--ease),
      background var(--duration) var(--ease),
      translate var(--duration) var(--ease);
  }
  a:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, transparent);
    translate: 2px 0;
  }
  a[aria-current='page'] {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
    font-weight: 700;
  }
  summary {
    cursor: pointer;
  }
  summary::marker {
    color: var(--color-ornament);
  }
</style>
