---
/** Left navigation: collapsible tree of unlimited depth (no JavaScript, <details> based). */
import type { Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import type { TreeNode } from '../../lib/tree';
import TreeItem from './TreeItem.astro';

interface Props {
  tree: TreeNode;
  locale: Locale;
  current: string;
}
const { tree, locale, current } = Astro.props;
const t = useT(locale);
---

<nav class="sidebar" aria-label={t('nav.sections')}>
  <ul class="tree" role="list">
    {tree.children.map((node) => (
      <TreeItem node={node} locale={locale} current={current} />
    ))}
  </ul>
</nav>

<style>
  .sidebar {
    position: sticky;
    top: 1rem;
    align-self: start;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
    font-size: 1rem;
  }
  .tree {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (max-width: 960px) {
    .sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--color-border);
    }
  }
</style>
