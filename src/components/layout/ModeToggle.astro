---
/** Light/dark toggle. The initial mode is set by an inline script in BaseLayout. */
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button type="button" class="mode-toggle" aria-label={label} title={label}>
  <span class="icon icon--moon" aria-hidden="true">
    ☾
  </span>
  <span class="icon icon--sun" aria-hidden="true">
    ☀
  </span>
</button>

<script>
  document.querySelector('.mode-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.mode === 'dark' ? 'light' : 'dark';
    root.dataset.mode = next;
    try {
      localStorage.setItem('codex-mode', next);
    } catch {
      /* storage unavailable: the choice lasts for this page only */
    }
  });
</script>

<style>
  .mode-toggle {
    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
    margin-left: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--color-on-wood) 25%, transparent);
    border-radius: 999px;
    background: transparent;
    color: var(--color-brass);
    cursor: pointer;
    font-size: 1.05rem;
    transition:
      border-color var(--duration) var(--ease),
      rotate 400ms var(--ease);
  }
  .mode-toggle:hover {
    border-color: var(--color-brass);
    rotate: 20deg;
  }
  .icon {
    grid-area: 1 / 1;
  }
  .icon--sun,
  :global([data-mode='dark']) .icon--moon {
    display: none;
  }
  :global([data-mode='dark']) .icon--sun {
    display: inline;
  }
</style>
