---
/** Site header (sticky "shelf" bar): wordmark, search, tool links, language switcher and mode toggle. */
import { LOCALES, SITE, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { pageUrl } from '../../lib/urls';
import HeaderSearch from './HeaderSearch.astro';
import ModeToggle from './ModeToggle.astro';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const t = useT(locale);
const tools = [
  ['paths', t('nav.paths')],
  ['glossary', t('nav.glossary')],
  ['tags', t('nav.tags')],
  ['graph', t('nav.graph')],
  ['a-z', t('nav.az')],
] as const;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={pageUrl(locale, '')}>
      <span class="brand-name">{SITE.name}</span>
      <span class="ui-label brand-tagline">{t('site.tagline')}</span>
    </a>
    <HeaderSearch locale={locale} />
    <nav aria-label={t('nav.tools')} class="tools">
      {tools.map(([path, label]) => (
        <a href={pageUrl(locale, path)} aria-current={slug === path ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <nav aria-label={t('nav.language')} class="settings">
      {LOCALES.map((l) => (
        <a href={pageUrl(l, slug)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>
          {l.toUpperCase()}
        </a>
      ))}
      <ModeToggle label={t('nav.toggleMode')} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: linear-gradient(180deg, var(--color-wood-2), var(--color-wood));
    border-bottom: 2px solid var(--color-brass);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-ui);
    color: var(--color-on-wood);
  }
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    max-width: 96rem;
    min-height: var(--header-height);
    margin-inline: auto;
    padding: 0.5rem 2rem;
  }
  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    color: var(--color-on-wood);
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-brand);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brass);
    transition: text-shadow var(--duration) var(--ease);
  }
  .brand:hover .brand-name {
    text-shadow: 0 0 18px var(--color-lamp);
  }
  .brand-tagline {
    color: var(--color-on-wood-muted);
  }
  .tools,
  .settings {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .settings {
    margin-left: auto;
  }
  .tools a,
  .settings a {
    position: relative;
    padding: 0.45rem 0.7rem;
    border-radius: var(--radius);
    color: var(--color-on-wood);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition:
      color var(--duration) var(--ease),
      background var(--duration) var(--ease);
  }
  .tools a::after {
    content: '';
    position: absolute;
    inset: auto 0.7rem 0.2rem;
    height: 2px;
    background: var(--color-brass);
    scale: 0 1;
    transition: scale var(--duration) var(--ease);
  }
  .tools a:hover,
  .settings a:hover {
    color: var(--color-lamp);
    background: var(--on-wood-faint);
  }
  .tools a:hover::after,
  .tools a[aria-current]::after {
    scale: 1 1;
  }
  .settings a[aria-current] {
    color: var(--color-brass);
    font-weight: 700;
  }
  .site-header :global(:focus-visible) {
    outline-color: var(--color-lamp);
  }
  @media (max-width: 1200px) {
    .header-inner {
      gap: 0.75rem 1rem;
    }
    .brand-tagline {
      display: none;
    }
  }
  @media (max-width: 960px) {
    .site-header {
      position: static;
    }
    .header-inner {
      padding-inline: 1rem;
    }
    .tools {
      order: 4;
      width: 100%;
      overflow-x: auto;
    }
  }
</style>
