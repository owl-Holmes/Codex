---
/**
 * Glossary: every term of the locale (FR fallback), alphabetical, grouped by letter. Each term is a
 * full-width sheet: term and variants on the left, definition and notes on the right.
 * Each term is a heading with a stable id (#id), so Pagefind returns it as its own search sub-result
 * and other pages (Term component, A–Z index) can link straight to it.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LetterNav from '../../components/knowledge/LetterNav.astro';
import { LOCALES, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const all = await getCollection('glossary');
const idOf = (entryId: string) => entryId.split('/').slice(1).join('/');
const byId = new Map(all.filter((e) => e.id.startsWith('fr/')).map((e) => [idOf(e.id), e]));
all.filter((e) => e.id.startsWith(`${locale}/`)).forEach((e) => byId.set(idOf(e.id), e));
const terms = await Promise.all(
  [...byId]
    .sort(([, a], [, b]) => a.data.term.localeCompare(b.data.term, locale))
    .map(async ([id, entry]) => ({ id, entry, Body: (await render(entry)).Content })),
);
/** First letter without accents. */
const letterOf = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '')[0]?.toUpperCase() ?? '#';
const groups = new Map<string, typeof terms>();
terms.forEach((term) => {
  const key = letterOf(term.entry.data.term);
  groups.set(key, [...(groups.get(key) ?? []), term]);
});
const letters = [...groups.keys()].sort();
---

<BaseLayout locale={locale} slug="glossary" title={t('glossary.title')} description={t('glossary.title')}>
  <h1>{t('glossary.title')}</h1>
  <p class="intro">
    {t('glossary.intro')} <span class="ui-label">· {terms.length}</span>
  </p>
  <LetterNav letters={letters} label={t('az.letters')} />
  {letters.map((l) => (
    <section id={`letter-${l}`} aria-label={l}>
      <p class="letter-heading" aria-hidden="true">
        <span>{l}</span>
      </p>
      <div class="sheets">
        {groups.get(l)!.map(({ id, entry, Body }) => (
          <article class="sheet" lang={entry.id.startsWith(`${locale}/`) ? locale : 'fr'}>
            <header class="sheet-head">
              <h2 id={id} class="term">
                <a href={`#${id}`} title={t('glossary.permalink')}>
                  {entry.data.term}
                  <span class="hash" aria-hidden="true">
                    #
                  </span>
                </a>
              </h2>
              {entry.data.aliases.length > 0 && (
                <p class="aliases">
                  <span class="ui-label">{t('glossary.aliases')}</span>
                  {entry.data.aliases.map((a) => (
                    <span class="badge">{a}</span>
                  ))}
                </p>
              )}
            </header>
            <div class="sheet-body">
              <p class="definition">{entry.data.definition}</p>
              <div class="notes">
                <Body />
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .intro {
    color: var(--color-muted);
  }
  section {
    scroll-margin-top: calc(var(--header-height) + 5rem);
  }
  .sheets {
    display: grid;
    gap: 0.8rem;
  }
  .sheet {
    display: grid;
    grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
    gap: 0.5rem 2rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }
  .sheet:hover {
    border-color: var(--color-ornament);
    border-left-color: var(--color-accent);
  }
  .sheet:has(:target) {
    box-shadow: var(--glow);
  }
  .term {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: var(--text-lg);
    line-height: 1.25;
  }
  .term a {
    color: inherit;
    text-decoration: none;
  }
  .hash {
    margin-left: 0.3rem;
    color: var(--color-accent);
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }
  .term a:hover .hash,
  .term a:focus-visible .hash {
    opacity: 1;
  }
  .aliases {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem;
    margin: 0.5rem 0 0;
  }
  .sheet-body {
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border);
  }
  .definition {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 500;
    line-height: 1.55;
  }
  .notes {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .notes :global(p) {
    margin: 0.5rem 0 0;
  }
  @media (max-width: 700px) {
    .sheet {
      grid-template-columns: minmax(0, 1fr);
    }
    .sheet-body {
      padding: 0.6rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
