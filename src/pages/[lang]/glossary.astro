---
/**
 * Glossary: every term of the locale (FR fallback, see lib/glossary.ts), grouped by first letter
 * (lib/alphabet.ts). A LetterNav jumps between groups; each term is a GlossarySheet.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlossarySheet from '../../components/knowledge/GlossarySheet.astro';
import LetterNav from '../../components/knowledge/LetterNav.astro';
import { LOCALES, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { groupByLetter } from '../../lib/alphabet';
import { getGlossary } from '../../lib/glossary';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const terms = await getGlossary(locale);
const groups = groupByLetter(terms, (term) => term.entry.data.term, locale);
---

<BaseLayout locale={locale} slug="glossary" title={t('glossary.title')} description={t('glossary.title')}>
  <h1>{t('glossary.title')}</h1>
  <p class="page-intro">
    {t('glossary.intro')} <span class="ui-label">· {terms.length}</span>
  </p>
  <LetterNav letters={groups.map(([letter]) => letter)} label={t('az.letters')} />
  {groups.map(([letter, group]) => (
    <section id={`letter-${letter}`} class="letter-group" aria-label={letter}>
      <p class="letter-heading" aria-hidden="true">
        <span>{letter}</span>
      </p>
      <div class="sheets">
        {group.map((term) => (
          <GlossarySheet term={term} locale={locale} />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .letter-group {
    scroll-margin-top: calc(var(--header-height) + 5rem);
  }
  .sheets {
    display: grid;
    gap: 0.8rem;
  }
</style>
