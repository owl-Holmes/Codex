---
/** Global knowledge graph page: every page and its connections across categories. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeGraph from '../../components/knowledge/KnowledgeGraph.astro';
import { LOCALES, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = useT(locale);
---

<BaseLayout locale={locale} slug="graph" title={t('graph.title')} description={t('graph.label')} indexable={false}>
  <h1>{t('graph.title')}</h1>
  <p>{t('graph.intro')}</p>
  <KnowledgeGraph locale={locale} />
</BaseLayout>
