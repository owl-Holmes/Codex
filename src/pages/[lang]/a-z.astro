---
/**
 * A–Z index: every page and every glossary term, grouped by first letter (accents and leading
 * articles ignored, see lib/alphabet.ts). One LetterPanel per letter, a LetterNav to jump between them.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LetterNav from '../../components/knowledge/LetterNav.astro';
import LetterPanel, { type IndexEntry } from '../../components/knowledge/LetterPanel.astro';
import { LOCALES, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { groupByLetter } from '../../lib/alphabet';
import { getGlossary } from '../../lib/glossary';
import { getPageMap, resolvePage } from '../../lib/pages';
import { getTree, getTrail } from '../../lib/tree';
import { pageUrl } from '../../lib/urls';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const tree = await getTree(locale);

const slugs = [...(await getPageMap('fr')).keys()].filter(Boolean);
const pages: IndexEntry[] = await Promise.all(
  slugs.map(async (slug) => {
    const data = (await resolvePage(locale, slug))!.page.entry.data;
    return {
      label: data.title,
      url: pageUrl(locale, slug),
      kind: getTrail(tree, slug)[0]?.title ?? t('az.page'),
      text: data.description,
      isTerm: false,
    };
  }),
);
const terms: IndexEntry[] = (await getGlossary(locale)).map(({ id, entry }) => ({
  label: entry.data.term,
  url: `${pageUrl(locale, 'glossary')}#${id}`,
  kind: t('nav.glossary'),
  text: entry.data.definition,
  isTerm: true,
}));
const groups = groupByLetter([...pages, ...terms], (e) => e.label, locale);
---

<BaseLayout locale={locale} slug="a-z" title={t('az.title')} description={t('az.title')} indexable={false}>
  <h1>{t('az.title')}</h1>
  <p class="page-intro">{t('az.intro')}</p>
  <LetterNav letters={groups.map(([letter]) => letter)} label={t('az.letters')} />
  <div class="panels">
    {groups.map(([letter, entries]) => (
      <LetterPanel letter={letter} entries={entries} locale={locale} />
    ))}
  </div>
</BaseLayout>

<style>
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    align-items: start;
    gap: 1rem;
  }
</style>
