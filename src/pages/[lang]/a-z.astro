---
/**
 * A–Z index: every page and glossary term, grouped by first letter (accents ignored),
 * one panel per letter; each entry is a fully clickable row with its section (or "Glossary")
 * and a one-line description.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOCALES, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import LetterNav from '../../components/knowledge/LetterNav.astro';
import { getPageMap, resolvePage } from '../../lib/pages';
import { getTree, getTrail } from '../../lib/tree';
import { pageUrl } from '../../lib/urls';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = useT(locale);

const tree = await getTree(locale);
const pages = await Promise.all(
  [...(await getPageMap('fr')).keys()].filter(Boolean).map(async (slug) => {
    const data = (await resolvePage(locale, slug))!.page.entry.data;
    return {
      label: data.title,
      url: pageUrl(locale, slug),
      kind: getTrail(tree, slug)[0]?.title ?? t('az.page'),
      text: data.description,
      isTerm: false,
    };
  }),
);
// FR terms first, then the locale's own terms override them (FR fallback).
const allTerms = await getCollection('glossary');
const glossary = new Map(
  [...allTerms.filter((e) => e.id.startsWith('fr/')), ...allTerms.filter((e) => e.id.startsWith(`${locale}/`))].map(
    (e) => [e.id.split('/')[1], e],
  ),
);
const terms = [...glossary].map(([id, e]) => ({
  label: e.data.term,
  url: `${pageUrl(locale, 'glossary')}#${id}`,
  kind: t('nav.glossary'),
  text: e.data.definition,
  isTerm: true,
}));

/** First significant letter, without leading articles' apostrophes or accents. */
const letterOf = (s: string) =>
  s
    .replace(/^(l['’]|la |le |les |the )/i, '')
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')[0]
    ?.toUpperCase() ?? '#';
const groups = new Map<string, typeof pages>();
[...pages, ...terms]
  .sort((a, b) => a.label.localeCompare(b.label, locale, { sensitivity: 'base' }))
  .forEach((item) => {
    const key = letterOf(item.label);
    groups.set(key, [...(groups.get(key) ?? []), item]);
  });
const letters = [...groups.keys()].sort();
---

<BaseLayout locale={locale} slug="a-z" title={t('az.title')} description={t('az.title')} indexable={false}>
  <h1>{t('az.title')}</h1>
  <p class="intro">{t('az.intro')}</p>
  <LetterNav letters={letters} label={t('az.letters')} />
  <div class="panels">
    {letters.map((l) => (
      <section id={`letter-${l}`} class="panel" aria-labelledby={`h-${l}`}>
        <header class="panel-head">
          <h2 id={`h-${l}`} class="letter">
            {l}
          </h2>
          <span class="ui-label">
            {groups.get(l)!.length} {t(groups.get(l)!.length > 1 ? 'az.entries' : 'az.entry')}
          </span>
        </header>
        <ul class="rows">
          {groups.get(l)!.map((item) => (
            <li>
              <a class="row" href={item.url} data-no-preview>
                <span class="row-main">
                  <span class="row-title">{item.label}</span>
                  <span class="row-text">{item.text}</span>
                </span>
                <span class:list={['badge', { 'badge--accent': item.isTerm }]}>{item.kind}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .intro {
    color: var(--color-muted);
  }
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    align-items: start;
    gap: 1rem;
  }
  .panel {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    scroll-margin-top: calc(var(--header-height) + 5rem);
  }
  .panel:target {
    box-shadow: var(--glow);
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-accent) 6%, var(--color-surface));
  }
  .letter {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-label);
    font-size: var(--text-md);
  }
  .rows {
    margin: 0;
    padding: 0.3rem;
    list-style: none;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius);
    color: var(--color-text);
    text-decoration: none;
    transition: background var(--duration) var(--ease);
  }
  .row:hover,
  .row:focus-visible {
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }
  .row-main {
    display: grid;
    flex: 1;
    min-width: 0;
  }
  .row-title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
  }
  .row:hover .row-title {
    color: var(--color-accent);
  }
  .row-text {
    overflow: hidden;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .badge {
    flex: none;
  }
</style>
