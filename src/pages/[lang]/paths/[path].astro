---
/**
 * One thematic path: reading progress (StepProgress), then its ordered steps as a vertical timeline
 * of fully clickable cards; steps already read in this browser get a filled number and a badge.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StepProgress from '../../../components/knowledge/StepProgress.astro';
import { LOCALES, type Locale } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { getPaths, resolveSteps } from '../../../lib/paths';
import { pageUrl } from '../../../lib/urls';

export async function getStaticPaths() {
  const ids = (await getPaths('fr')).map((p) => p.id);
  return LOCALES.flatMap((lang) => ids.map((path) => ({ params: { lang, path } })));
}
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const path = (await getPaths(locale)).find((p) => p.id === Astro.params.path)!;
const steps = await resolveSteps(locale, path);
---

<BaseLayout locale={locale} slug={`paths/${path.id}`} title={path.data.title} description={path.data.description}>
  <p>
    <a href={pageUrl(locale, 'paths')}>← {t('paths.title')}</a>
  </p>
  <h1>{path.data.title}</h1>
  <p class="page-intro">{path.data.description}</p>
  <StepProgress pages={steps.map((s) => s.page)} locale={locale} />
  <ol class="timeline" data-visited-label={t('paths.visited')}>
    {steps.map((s, i) => (
      <li data-page={s.page}>
        <span class="num" aria-hidden="true">
          {i + 1}
        </span>
        <a class="entry-card" href={pageUrl(locale, s.page)} data-no-preview>
          <span class="meta">
            <span class="ui-label">
              {t('paths.step')} {i + 1}
            </span>
            {s.section && <span class="badge">{s.section}</span>}
            <span class="badge badge--accent visited" hidden>
              ✓ {t('paths.visited')}
            </span>
          </span>
          <span class="entry-card-title">{s.title}</span>
          {s.note && <span class="entry-card-text">{s.note}</span>}
        </a>
      </li>
    ))}
  </ol>
</BaseLayout>

<script>
  import { getVisited } from '../../../components/knowledge/visited';
  const visited = getVisited();
  document.querySelectorAll<HTMLElement>('.timeline li[data-page]').forEach((li) => {
    if (!visited.has(li.dataset.page ?? '')) return;
    li.classList.add('is-visited');
    li.querySelector<HTMLElement>('.visited')?.removeAttribute('hidden');
  });
</script>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 0.9rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  /* Vertical rail behind the numbers. */
  .timeline::before {
    content: '';
    position: absolute;
    left: 1.15rem;
    top: 1rem;
    bottom: 1rem;
    width: 2px;
    background: color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 2.3rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .num {
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    margin-top: 0.7rem;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-accent);
    font-family: var(--font-label);
    font-weight: 700;
  }
  li:global(.is-visited) .num {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
</style>
