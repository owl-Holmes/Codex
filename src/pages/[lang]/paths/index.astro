---
/** List of thematic paths as rich cards (see PathCard). */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PathCard from '../../../components/knowledge/PathCard.astro';
import { LOCALES, type Locale } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { getPaths } from '../../../lib/paths';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const t = useT(locale);
const paths = await getPaths(locale);
---

<BaseLayout locale={locale} slug="paths" title={t('paths.title')} description={t('paths.intro')}>
  <h1>{t('paths.title')}</h1>
  <p class="intro">{t('paths.intro')}</p>
  <ul class="paths">
    {paths.map((p) => (
      <li>
        <PathCard path={p} locale={locale} />
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro {
    color: var(--color-muted);
  }
  .paths {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
</style>
