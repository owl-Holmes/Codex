---
/** Language home: short intro, section "shelves", recent pages, thematic paths and the knowledge graph. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RandomPage from '../../components/navigation/RandomPage.astro';
import SectionCard from '../../components/knowledge/SectionCard.astro';
import KnowledgeGraph from '../../components/knowledge/KnowledgeGraph.astro';
import { LOCALES, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getAllPages } from '../../lib/pages';
import { getPaths } from '../../lib/paths';
import { countPages, getTree } from '../../lib/tree';
import { pageUrl } from '../../lib/urls';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useT(locale);
const tree = await getTree(locale);
const dateOf = (d: { updated?: Date; created: Date }) => d.updated ?? d.created;
const recent = (await getAllPages())
  .filter((p) => p.locale === 'fr' && p.slug)
  .sort((a, b) => dateOf(b.entry.data).getTime() - dateOf(a.entry.data).getTime())
  .slice(0, 6);
const sectionTitle = new Map(tree.children.map((n) => [n.slug, n.title]));
const formatDate = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric' });
const paths = (await getPaths(locale)).slice(0, 3);
const pageCount = countPages(tree);
---

<BaseLayout locale={locale} slug="" title={t('home.title')} description={t('home.intro')} wide indexable={false}>
  <header class="home-head">
    <p class="eyebrow">{t('home.eyebrow')}</p>
    <h1>{t('home.title')}</h1>
    <p class="intro">{t('home.intro')}</p>
    <div class="actions">
      <button type="button" class="search-cta" data-open-palette>
        {t('home.searchCta')} <kbd>Ctrl K</kbd>
      </button>
      <RandomPage locale={locale} />
      <span class="count">
        {pageCount} {t('home.pages')}
      </span>
    </div>
  </header>

  <section id="shelves" class="block" aria-labelledby="shelves-title">
    <header class="block-head">
      <h2 id="shelves-title">{t('home.shelves')}</h2>
    </header>
    <div class="shelves">
      {tree.children.map((node, i) => (
        <SectionCard node={node} locale={locale} index={i} />
      ))}
    </div>
  </section>

  <div class="columns">
    <section class="block" aria-labelledby="recent-title">
      <header class="block-head">
        <h2 id="recent-title">{t('home.recent')}</h2>
      </header>
      <ol class="recent" role="list">
        {recent.map((p) => (
          <li>
            <a href={pageUrl(locale, p.slug)}>
              <span class="recent-section">{sectionTitle.get(p.slug.split('/')[0])}</span>
              <span class="recent-title">{p.entry.data.title}</span>
              <time datetime={dateOf(p.entry.data).toISOString()}>{formatDate.format(dateOf(p.entry.data))}</time>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {paths.length > 0 && (
      <section class="block" aria-labelledby="paths-title">
        <header class="block-head">
          <h2 id="paths-title">{t('paths.title')}</h2>
          <p>{t('paths.intro')}</p>
        </header>
        <ul class="paths" role="list">
          {paths.map((p) => (
            <li>
              <a href={pageUrl(locale, `paths/${p.id}`)}>
                <span class="path-title">{p.data.title}</span>
                <span class="path-desc">{p.data.description}</span>
                <span class="path-steps">
                  {p.data.steps.length} {t('paths.steps')} →
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a class="more" href={pageUrl(locale, 'paths')}>
          {t('home.allPaths')} →
        </a>
      </section>
    )}
  </div>

  <section class="block" aria-labelledby="graph-title">
    <header class="block-head">
      <h2 id="graph-title">{t('graph.title')}</h2>
      <p>{t('graph.intro')}</p>
    </header>
    <KnowledgeGraph locale={locale} />
  </section>
</BaseLayout>

<style>
  .home-head {
    padding-bottom: 0.5rem;
  }
  .eyebrow {
    margin: 0 0 0.3rem;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-ornament);
  }
  .home-head h1 {
    font-family: var(--font-brand);
    letter-spacing: 0.08em;
  }
  .intro {
    margin: 0.4rem 0 1.2rem;
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .search-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-ornament);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      translate var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }
  .search-cta:hover {
    translate: 0 -2px;
    box-shadow: var(--glow);
  }
  .search-cta kbd {
    padding: 0 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: inherit;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .count {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .block {
    margin-top: 2.8rem;
  }
  .block-head {
    margin-bottom: 1.4rem;
  }
  .block-head h2 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .block-head h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--color-ornament), transparent);
  }
  .block-head p {
    margin: 0.4rem 0 0;
    color: var(--color-muted);
  }
  .shelves {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr));
    gap: 0.9rem;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 0 3rem;
  }
  .recent,
  .paths {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent a,
  .paths a {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-ornament);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      translate var(--duration) var(--ease),
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }
  .recent a:hover,
  .paths a:hover {
    translate: 4px 0;
    border-color: var(--color-ornament);
    border-left-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
  }
  .recent a {
    grid-template-columns: 1fr auto;
  }
  .recent-section,
  .path-steps,
  .recent time {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .recent-section {
    grid-column: 1 / -1;
    color: var(--color-accent);
  }
  .recent-title,
  .path-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
  }
  .recent time {
    align-self: center;
  }
  .path-desc {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .more {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
</style>
