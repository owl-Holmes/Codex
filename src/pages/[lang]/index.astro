---
/** Language home: short intro, section "shelves", recent pages, thematic paths and the knowledge graph. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeBlock from '../../components/home/HomeBlock.astro';
import PathCards from '../../components/home/PathCards.astro';
import RecentPages from '../../components/home/RecentPages.astro';
import KnowledgeGraph from '../../components/knowledge/KnowledgeGraph.astro';
import SectionCard from '../../components/knowledge/SectionCard.astro';
import RandomPage from '../../components/navigation/RandomPage.astro';
import { LOCALES, type Locale } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getPaths } from '../../lib/paths';
import { countPages, getTree } from '../../lib/tree';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useT(locale);
const tree = await getTree(locale);
const paths = (await getPaths(locale)).slice(0, 3);
---

<BaseLayout locale={locale} slug="" title={t('home.title')} description={t('home.intro')} wide indexable={false}>
  <header class="home-head">
    <p class="ui-label eyebrow">{t('home.eyebrow')}</p>
    <h1>{t('home.title')}</h1>
    <p class="intro">{t('home.intro')}</p>
    <div class="actions">
      <button type="button" class="pill search-cta" data-open-palette>
        {t('home.searchCta')} <kbd>Ctrl K</kbd>
      </button>
      <RandomPage locale={locale} />
      <span class="ui-label">
        {countPages(tree)} {t('home.pages')}
      </span>
    </div>
  </header>

  <HomeBlock id="shelves" title={t('home.shelves')}>
    <div class="card-grid">
      {tree.children.map((node, i) => (
        <SectionCard node={node} locale={locale} index={i} />
      ))}
    </div>
  </HomeBlock>

  <div class="columns">
    <HomeBlock id="recent" title={t('home.recent')}>
      <RecentPages locale={locale} tree={tree} />
    </HomeBlock>
    {paths.length > 0 && (
      <HomeBlock id="paths" title={t('paths.title')} intro={t('paths.intro')}>
        <PathCards locale={locale} paths={paths} />
      </HomeBlock>
    )}
  </div>

  <HomeBlock id="graph" title={t('graph.title')} intro={t('graph.intro')}>
    <KnowledgeGraph locale={locale} />
  </HomeBlock>
</BaseLayout>

<style>
  .eyebrow {
    margin: 0 0 0.3rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    color: var(--color-ornament);
  }
  h1 {
    font-family: var(--font-brand);
    letter-spacing: 0.08em;
  }
  .intro {
    margin: 0.4rem 0 1.2rem;
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .search-cta {
    border-color: var(--color-ornament);
  }
  kbd {
    padding: 0 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-family: inherit;
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    gap: 0 3rem;
  }
</style>
