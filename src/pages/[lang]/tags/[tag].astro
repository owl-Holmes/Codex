---
/** Pages sharing one tag, across every category (the main cross-category discovery view). */
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageList from '../../../components/knowledge/PageList.astro';
import { LOCALES, type Locale } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { getTagIndex } from '../../../lib/tags';
import { pageUrl } from '../../../lib/urls';

export async function getStaticPaths() {
  const tags = [...(await getTagIndex()).keys()];
  return LOCALES.flatMap((lang) => tags.map((tag) => ({ params: { lang, tag } })));
}
const locale = Astro.params.lang as Locale;
const tag = Astro.params.tag!;
const t = useT(locale);
const pages = (await getTagIndex()).get(tag) ?? [];
const info = await getEntry('tags', tag);
---

<BaseLayout
  locale={locale}
  slug={`tags/${tag}`}
  title={`#${tag}`}
  description={`${t('tags.title')} : ${tag}`}
  indexable={false}
>
  <p>
    <a href={pageUrl(locale, 'tags')}>← {t('tags.title')}</a>
  </p>
  <h1>#{tag}</h1>
  {info && <p class="tag-description">{info.data.description[locale]}</p>}
  <PageList heading={t('tags.pages')} slugs={pages.map((p) => p.slug)} locale={locale} />
</BaseLayout>
