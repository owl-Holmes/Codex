{
  "name": "codex",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "i18n:status": "node scripts/i18n-status.mjs",
    "i18n:stamp": "node scripts/i18n-stamp.mjs",
    "audit:leaks": "node scripts/audit-leaks.mjs",
    "validate": "npm run check && npm run lint && npm run format:check && npm run test && npm run contrast && npm run audit:leaks",
    "new:page": "node scripts/new-page.mjs",
    "links": "node scripts/check-links.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "new:section": "node scripts/new-section.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "astro": "7.4.2",
    "katex": "0.19.1",
    "lottie-web": "5.13.0",
    "mermaid": "12.2.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
